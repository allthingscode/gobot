#!/bin/sh
# Crucible framework pre-commit hook
# Runs generated-doc, mojibake, ASCII-only, timestamp, prompt-version and Go lint
# checks, plus a merge conflict marker scan.
# A non-zero exit from any check aborts the commit.

set -e

# Resolve hooks directory from the location of this hook script
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve the framework root relative to the hook's directory (always 2 levels up)
FRAMEWORK_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"

# Resolve the repository root where the commit is occurring
REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"

# Resolve platform-appropriate PowerShell command. Windows prefers powershell.exe so it
# runs Windows PowerShell 5.1, the field-tested host matching CI. The OS is tested rather
# than inferred from the lookup succeeding: under WSL, Windows PATH interop puts
# /mnt/c/.../powershell.exe on PATH, so a bare `command -v powershell.exe` hands a Linux
# repository to a Windows host. That host sees the work tree as \\wsl.localhost\... , which
# git will not treat as a repository, so index-reading gates exit 129 on a correct tree.
case "$(uname -s)" in
    Linux|Darwin) PWSH="$(command -v pwsh)" ;;
    *)            PWSH="$(command -v powershell.exe || command -v pwsh)" ;;
esac

echo "--- Crucible pre-commit verification started"

if [ "$REPO_ROOT" = "$FRAMEWORK_ROOT" ]; then
    # FRAMEWORK REPO CONTEXT
    cd "$REPO_ROOT"

    # 1. Generated documentation check
    # The budget tiers in docs/ are rendered from $script:BUDGET_CEILINGS and verified
    # by byte comparison. This replaced check-policy-drift.ps1, whose tier comparison
    # sourced its expectation from the policy table by regex, never matched, and so
    # reported "synchronized" on every commit since the initial one. The remaining
    # policy rules it carried now live in crucible_lint below.
    echo "Running generated documentation check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-generated-docs.ps1

    # 2. Mojibake check
    # The scope is listed explicitly so this gate's reach is reviewable in the hook
    # itself rather than inferred from the script's defaults. It must stay in sync with
    # the framework branch of check-mojibake.ps1; check-mojibake.tests.ps1 pins both
    # against the tracked root *.md files so a new root doc cannot silently fall out.
    # This leg scans a fixed path list, not the staged files - the adopter leg below is
    # the one that scans what is being committed.
    echo "Running mojibake check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-mojibake.ps1 prompts personas sops docs powershell templates README.md ROADMAP.md CHANGELOG.md CONTRIBUTING.md TODO.md

    # 3. ASCII-only check
    # The rule CONTRIBUTING.md has always stated, now enforced. It takes no path list:
    # every tracked file is in scope, because the three violations that sat outside the
    # mojibake gate's .md/.ps1 walk were in a .json, a .go and an extensionless
    # gitignore - exactly what an extension allowlist would have missed. Item 86.
    echo "Running ASCII-only check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-ascii.ps1

    # 4. Culture-sensitive timestamp check
    echo "Running culture-sensitive timestamp check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-culture-sensitive-time.ps1

    # 5. Prompt version bump check
    # The operating manual calls the bump a MUST and nothing checked it, so three
    # commits edited all five phase prompts and bumped zero versions. This reads the
    # index rather than a path list: it is the staged body, against HEAD's, that
    # distinguishes an edit from a bump.
    echo "Running prompt version bump check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-prompt-version.ps1

    # 6. Go Crucible Lint check
    # The backlog directory is resolved here, by the one config parser, and handed to
    # the linter. crucible_lint used to re-derive it from config.yaml with a second
    # parser that only matched a 2-space paths: block; anything else fell back to the
    # default directory, which does not exist, and all three backlog lints passed
    # without looking at anything. tr strips the CR that powershell.exe appends.
    echo "Running crucible lint checks..."
    BACKLOG_DIR="$("$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/resolve-config-path.ps1 -Key backlog -ProjectRoot "$REPO_ROOT" | tr -d '\r')"
    go run scripts/crucible_lint.go -framework-root "$FRAMEWORK_ROOT" -backlog-dir "$BACKLOG_DIR"

    # 7. Unresolved Merge Conflict check
    echo "Scanning staged files for unresolved merge conflict markers..."
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        # Filter files that exist to avoid grep errors on deleted staged files
        EXISTING_STAGED_FILES=""
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                EXISTING_STAGED_FILES="$EXISTING_STAGED_FILES $file"
            fi
        done
        if [ -n "$EXISTING_STAGED_FILES" ]; then
            if grep -E '^(<{7}|={7}$|>{7})' $EXISTING_STAGED_FILES >/dev/null 2>&1; then
                echo "ERROR: Unresolved merge conflicts detected in staged files. Please fix them before committing."
                exit 1
            fi
        fi
    fi
else
    # ADOPTER REPO CONTEXT
    # Run only adopter-appropriate checks
    cd "$REPO_ROOT"

    # 1. Unresolved Merge Conflict check of staged files
    echo "Scanning staged files for unresolved merge conflict markers..."
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        # Filter files that exist to avoid grep errors on deleted staged files
        EXISTING_STAGED_FILES=""
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                EXISTING_STAGED_FILES="$EXISTING_STAGED_FILES $file"
            fi
        done
        if [ -n "$EXISTING_STAGED_FILES" ]; then
            if grep -E '^(<{7}|={7}$|>{7})' $EXISTING_STAGED_FILES >/dev/null 2>&1; then
                echo "ERROR: Unresolved merge conflicts detected in staged files. Please fix them before committing."
                exit 1
            fi
        fi
    fi

    # 2. Mojibake check of the adopter's staged files
    # Only scan staged .md and .ps1 files that exist
    STAGED_FILES_MOJIBAKE=""
    if [ -n "$STAGED_FILES" ]; then
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                case "$file" in
                    *.md|*.ps1)
                        STAGED_FILES_MOJIBAKE="$STAGED_FILES_MOJIBAKE $file"
                        ;;
                esac
            fi
        done
    fi

    if [ -n "$STAGED_FILES_MOJIBAKE" ]; then
        echo "Running mojibake check on staged files..."
        # Pass files positionally (not via -Paths): in powershell.exe -File mode a named
        # array param binds only the first token; ValueFromRemainingArguments collects all
        # positional args. Regression: check-mojibake.tests.ps1.
        "$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$FRAMEWORK_ROOT/powershell/gates/check-mojibake.ps1" $STAGED_FILES_MOJIBAKE
    fi
fi

echo "--- Pre-commit: all verification tests passed!"
