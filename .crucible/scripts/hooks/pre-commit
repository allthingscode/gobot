#!/bin/sh
# Crucible framework pre-commit hook
# Runs generated-doc, prompt-version and Go lint checks, the mojibake, ASCII-only and
# timestamp checks over the staged files, and a merge conflict marker scan. The
# whole-tree forms of the staged scans run in pre-push.
# A non-zero exit from any check aborts the commit.

set -e

# Resolve hooks directory from the location of this hook script
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve the framework root relative to the hook's directory (always 2 levels up)
FRAMEWORK_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"

# Resolve the repository root where the commit is occurring
REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"

# PowerShell 7+ (pwsh) is required. Do not look up powershell.exe: under WSL, Windows
# PATH interop puts /mnt/c/.../powershell.exe on PATH and would hand a Linux repository
# to Windows PowerShell 5.1. That host sees the work tree as \\wsl.localhost\... , which
# git will not treat as a repository, so index-reading gates exit 129 on a correct tree.
# uname still decides: a Windows pwsh.exe on a Linux PATH is the same trap.
PWSH="$(command -v pwsh)"
case "$(uname -s)" in
    Linux|Darwin)
        case "$PWSH" in
            *.exe|/mnt/*)
                echo "ERROR: pwsh resolved to a Windows binary ($PWSH). Install PowerShell 7+ in this OS." >&2
                exit 1
                ;;
        esac
        ;;
esac
if [ -z "$PWSH" ]; then
    echo "ERROR: pwsh (PowerShell 7+) was not found on PATH." >&2
    exit 1
fi

# Chain to the project's own hook of the same name. core.hooksPath points git at
# Crucible's hooks, which shadows any hooks the project keeps elsewhere, so an adopter
# names that directory in .crucible/config.yaml (hooks.project_dir) and each Crucible
# hook runs the project's hook after its own checks. The grep is only a fast path that
# keeps PowerShell off every commit that has not set the key; the one config parser
# decides what the key says. The project hook runs through its shebang so a clone that
# recorded it without the executable bit, as a Windows commit does, still runs it.
# Item 150.
PROJECT_HOOK_RAN=""
run_project_hook() {
    project_hook_name="$1"
    shift
    if ! grep -q 'project_dir' "$REPO_ROOT/.crucible/config.yaml" 2>/dev/null; then
        return 0
    fi
    if ! project_hooks_dir="$("$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$FRAMEWORK_ROOT/powershell/resolve-project-hooks-dir.ps1" -ProjectRoot "$REPO_ROOT")"; then
        echo "ERROR: could not resolve hooks.project_dir; the project's $project_hook_name hook did not run." >&2
        exit 1
    fi
    project_hooks_dir="$(printf '%s' "$project_hooks_dir" | tr -d '\r')"
    if [ -z "$project_hooks_dir" ]; then
        return 0
    fi
    project_hook="$project_hooks_dir/$project_hook_name"
    if [ ! -f "$project_hook" ]; then
        echo "No project $project_hook_name hook in $project_hooks_dir; nothing to chain."
        return 0
    fi
    project_hook_first="$(head -n 1 "$project_hook" | tr -d '\r')"
    case "$project_hook_first" in
        '#!'*) project_hook_interp="${project_hook_first#??}" ;;
        *) project_hook_interp="sh" ;;
    esac
    echo "Running project hook: $project_hook"
    set +e
    # Unquoted on purpose: '/usr/bin/env bash' is a command and an argument.
    $project_hook_interp "$project_hook" "$@"
    project_hook_status=$?
    set -e
    if [ "$project_hook_status" -ne 0 ]; then
        echo "ERROR: project hook $project_hook failed (exit $project_hook_status)." >&2
        exit "$project_hook_status"
    fi
    PROJECT_HOOK_RAN=1
}

echo "--- Crucible pre-commit verification started"

if [ "$REPO_ROOT" = "$FRAMEWORK_ROOT" ]; then
    # FRAMEWORK REPO CONTEXT
    cd "$REPO_ROOT"

    # 1. Generated documentation check
    # The budget tiers in docs/ are rendered from $script:BUDGET_CEILINGS and verified
    # by byte comparison. This replaced check-policy-drift.ps1, whose tier comparison
    # sourced its expectation from the policy table by regex, never matched, and so
    # reported "synchronized" on every commit since the initial one. The remaining
    # policy rules it carried now live in crucible_lint below.
    echo "Running generated documentation check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-generated-docs.ps1

    # 2-4. Mojibake, ASCII-only, and culture-sensitive timestamp checks, over the staged
    # files only. The whole-tree scans took about 45 of this hook's 80 seconds and find
    # nothing at commit that pre-push does not find before anything leaves the machine,
    # so pre-push runs them in full. A staged file is still judged here, which is where
    # its author can fix it. Item 151.
    echo "Running mojibake check on staged files..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-mojibake.ps1 -Staged

    echo "Running ASCII-only check on staged files..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-ascii.ps1 -Staged

    echo "Running culture-sensitive timestamp check on staged files..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-culture-sensitive-time.ps1 -Staged

    # 5. Prompt version bump check
    # The operating manual calls the bump a MUST and nothing checked it, so three
    # commits edited all five phase prompts and bumped zero versions. This reads the
    # index rather than a path list: it is the staged body, against HEAD's, that
    # distinguishes an edit from a bump.
    echo "Running prompt version bump check..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-prompt-version.ps1

    # 6. Go Crucible Lint check
    # The backlog directory is resolved here, by the one config parser, and handed to
    # the linter. crucible_lint used to re-derive it from config.yaml with a second
    # parser that only matched a 2-space paths: block; anything else fell back to the
    # default directory, which does not exist, and all three backlog lints passed
    # without looking at anything. tr strips the CR that powershell.exe appends.
    # The linter runs from a binary cached under the gitignored .cache/, rebuilt when
    # scripts/crucible_lint.go is newer than it. `go run` recompiled it on every commit,
    # about 35 seconds. It is built to a temporary name and moved into place so an
    # interrupted build never leaves a half-written binary to run next time. Item 151.
    echo "Running crucible lint checks..."
    BACKLOG_DIR="$("$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/resolve-config-path.ps1 -Key backlog -ProjectRoot "$REPO_ROOT" | tr -d '\r')"
    LINT_EXT=""
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) LINT_EXT=".exe" ;;
    esac
    LINT_CACHE_DIR="$REPO_ROOT/.cache/crucible_lint"
    LINT_BIN="$LINT_CACHE_DIR/crucible_lint$LINT_EXT"
    if [ ! -f "$LINT_BIN" ] || [ scripts/crucible_lint.go -nt "$LINT_BIN" ]; then
        echo "Building crucible_lint into .cache/crucible_lint (source changed or no cached binary)..."
        mkdir -p "$LINT_CACHE_DIR"
        LINT_TMP="$LINT_CACHE_DIR/crucible_lint.building.$$$LINT_EXT"
        go build -o "$LINT_TMP" scripts/crucible_lint.go
        mv -f "$LINT_TMP" "$LINT_BIN"
    fi
    "$LINT_BIN" -framework-root "$FRAMEWORK_ROOT" -backlog-dir "$BACKLOG_DIR"

    # 7. Unresolved Merge Conflict check
    echo "Scanning staged files for unresolved merge conflict markers..."
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        # Filter files that exist to avoid grep errors on deleted staged files
        EXISTING_STAGED_FILES=""
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                EXISTING_STAGED_FILES="$EXISTING_STAGED_FILES $file"
            fi
        done
        if [ -n "$EXISTING_STAGED_FILES" ]; then
            if grep -E '^(<{7}|={7}$|>{7})' $EXISTING_STAGED_FILES >/dev/null 2>&1; then
                echo "ERROR: Unresolved merge conflicts detected in staged files. Please fix them before committing."
                exit 1
            fi
        fi
    fi
else
    # ADOPTER REPO CONTEXT
    # Run only adopter-appropriate checks
    cd "$REPO_ROOT"

    # 1. Unresolved Merge Conflict check of staged files
    echo "Scanning staged files for unresolved merge conflict markers..."
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        # Filter files that exist to avoid grep errors on deleted staged files
        EXISTING_STAGED_FILES=""
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                EXISTING_STAGED_FILES="$EXISTING_STAGED_FILES $file"
            fi
        done
        if [ -n "$EXISTING_STAGED_FILES" ]; then
            if grep -E '^(<{7}|={7}$|>{7})' $EXISTING_STAGED_FILES >/dev/null 2>&1; then
                echo "ERROR: Unresolved merge conflicts detected in staged files. Please fix them before committing."
                exit 1
            fi
        fi
    fi

    # 2. Mojibake check of the adopter's staged files
    # Only scan staged .md and .ps1 files that exist
    STAGED_FILES_MOJIBAKE=""
    if [ -n "$STAGED_FILES" ]; then
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                case "$file" in
                    *.md|*.ps1)
                        STAGED_FILES_MOJIBAKE="$STAGED_FILES_MOJIBAKE $file"
                        ;;
                esac
            fi
        done
    fi

    if [ -n "$STAGED_FILES_MOJIBAKE" ]; then
        echo "Running mojibake check on staged files..."
        # Pass files positionally (not via -Paths): in powershell.exe -File mode a named
        # array param binds only the first token; ValueFromRemainingArguments collects all
        # positional args. Regression: check-mojibake.tests.ps1.
        "$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$FRAMEWORK_ROOT/powershell/gates/check-mojibake.ps1" $STAGED_FILES_MOJIBAKE
    fi

    # 3. The project's own pre-commit hook, when hooks.project_dir names one
    run_project_hook pre-commit "$@"
fi

echo "--- Pre-commit: all verification tests passed!"
