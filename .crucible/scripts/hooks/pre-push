#!/bin/sh
# Crucible framework pre-push hook
# Runs all verification, scaffolding, and integration tests before code is pushed to remote.
# A non-zero exit from any test suite aborts the push. In an adopter repo every step below is
# skipped by design, and the hook says so instead of claiming that verification passed.
# Item 115.

set -e

# Resolve hooks directory from the location of this hook script
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve the framework root relative to the hook's directory (always 2 levels up)
FRAMEWORK_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"

# Resolve the repository root where the push is occurring
REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd)"

# Git feeds the push refs to this hook on stdin exactly once. More than one step
# consumes them, and a second `while read` would reach EOF and silently run nothing -
# a step that reports success having checked no refs at all. Capture the refs to a
# file so every consumer reads the same input. Guarded on a tty because an
# interactive run has no refs to read and `cat` would block forever.
PUSH_REFS_FILE=""
if [ ! -t 0 ]; then
    PUSH_REFS_FILE="$(mktemp)"
    trap 'rm -f "$PUSH_REFS_FILE"' EXIT
    cat > "$PUSH_REFS_FILE"
fi

echo "--- Crucible pre-push verification started"

if [ "$REPO_ROOT" = "$FRAMEWORK_ROOT" ]; then
    # FRAMEWORK REPO CONTEXT
    cd "$REPO_ROOT"

    # PowerShell 7+ (pwsh) is required. Do not look up powershell.exe: under WSL,
    # Windows PATH interop puts /mnt/c/.../powershell.exe on PATH and would hand a
    # Linux repository to Windows PowerShell 5.1. That host sees the work tree as
    # \\wsl.localhost\... and cannot read its index. Regression:
    # check-assertion-deletion.tests.ps1 drives a real hook on Linux.
    # uname still decides: a Windows pwsh.exe on a Linux PATH is the same trap.
    PWSH="$(command -v pwsh)"
    case "$(uname -s)" in
        Linux|Darwin)
            case "$PWSH" in
                *.exe|/mnt/*)
                    echo "ERROR: pwsh resolved to a Windows binary ($PWSH). Install PowerShell 7+ in this OS." >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
    if [ -z "$PWSH" ]; then
        echo "ERROR: pwsh (PowerShell 7+) was not found on PATH." >&2
        exit 1
    fi

    # 1. Project Scaffolding unit tests
    echo "Running project scaffolding tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/init-project-core.tests.ps1
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/init-project-instructions.tests.ps1
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/init-project-config-version.tests.ps1

    # 2. Config Validation unit tests
    echo "Running config validation tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/validate-config.tests.ps1

    # 3. Adopter Smoke tests
    echo "Running adopter smoke tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/adopter-smoke.tests.ps1

    # 4. File Affinity tests
    echo "Running file affinity tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/check-file-affinity.tests.ps1

    # 5. Core Crucible routing test suite
    echo "Running core Crucible routing tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/crucible.tests.ps1

    # 6. E2E Adopter Onboarding Bootstrap tests
    echo "Running adopter onboarding E2E bootstrap tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/adopter-bootstrap.tests.ps1

    # 7. Pre-push hook coverage tests
    echo "Running pre-push hook tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/pre-push-hook.tests.ps1

    # 8. Example bundle sync guard (examples/gobot mirror vs canonical)
    echo "Running examples mirror sync tests..."
    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/tests/examples-mirror-sync.tests.ps1

    # 9. Assertion Deletion gate check
    echo "Running assertion deletion check..."
    if [ -t 0 ]; then
        # Manual invocation: git always pipes ref data, so stdin being a terminal means
        # a human ran the hook by hand. Check what HEAD is ahead of its upstream rather
        # than the index, which at push time holds nothing worth inspecting.
        MANUAL_BASE="$(git rev-parse --verify --quiet '@{u}' 2>/dev/null || true)"
        if [ -n "$MANUAL_BASE" ]; then
            "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-assertion-deletion.ps1 -BaseRef "$MANUAL_BASE" -HeadRef HEAD
        else
            # No upstream: scan the branch's whole history. -Staged would be a silent
            # pass here, because at push time the index is normally empty.
            echo "Pre-push: HEAD has no upstream; scanning branch history instead."
            "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-assertion-deletion.ps1 -HeadRef HEAD
        fi
    else
        while read -r local_ref local_sha remote_ref remote_sha; do
            if [ -z "$local_sha" ]; then
                continue
            fi
            if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
                continue
            fi

            if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
                BASE_REF=""
                if git rev-parse --verify origin/main >/dev/null 2>&1; then
                    BASE_REF="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
                elif git rev-parse --verify main >/dev/null 2>&1; then
                    BASE_REF="$(git merge-base main "$local_sha" 2>/dev/null || true)"
                fi
                if [ -n "$BASE_REF" ]; then
                    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-assertion-deletion.ps1 -BaseRef "$BASE_REF" -HeadRef "$local_sha"
                else
                    # Nothing to compare against: scan the branch's whole history. Naming
                    # a base of "$local_sha~1" here would abort on a root commit.
                    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-assertion-deletion.ps1 -HeadRef "$local_sha"
                fi
            else
                "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-assertion-deletion.ps1 -BaseRef "$remote_sha" -HeadRef "$local_sha"
            fi
        done < "$PUSH_REFS_FILE"
    fi

    # 10. Linux leg verification gate check
    echo "Running Linux leg verification check..."
    if [ -t 0 ]; then
        MANUAL_BASE="$(git rev-parse --verify --quiet '@{u}' 2>/dev/null || true)"
        if [ -n "$MANUAL_BASE" ]; then
            "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-linux-leg.ps1 -BaseRef "$MANUAL_BASE" -HeadRef HEAD
        else
            # No upstream: scan the branch's whole history. -Staged would be a silent
            # pass here, because at push time the index is normally empty.
            echo "Pre-push: HEAD has no upstream; scanning branch history instead."
            "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-linux-leg.ps1 -HeadRef HEAD
        fi
    else
        while read -r local_ref local_sha remote_ref remote_sha; do
            if [ -z "$local_sha" ]; then
                continue
            fi
            if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
                continue
            fi

            if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
                BASE_REF=""
                if git rev-parse --verify origin/main >/dev/null 2>&1; then
                    BASE_REF="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
                elif git rev-parse --verify main >/dev/null 2>&1; then
                    BASE_REF="$(git merge-base main "$local_sha" 2>/dev/null || true)"
                fi
                if [ -n "$BASE_REF" ]; then
                    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-linux-leg.ps1 -BaseRef "$BASE_REF" -HeadRef "$local_sha"
                else
                    "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-linux-leg.ps1 -HeadRef "$local_sha"
                fi
            else
                "$PWSH" -NoProfile -ExecutionPolicy Bypass -File powershell/gates/check-linux-leg.ps1 -BaseRef "$remote_sha" -HeadRef "$local_sha"
            fi
        done < "$PUSH_REFS_FILE"
    fi

    # NOTE: This hook intentionally does not delete any working-tree files. Test
    # suites isolate into temp dirs and clean up after themselves; a verification
    # gate must never rm the repo (a stray ".crucible" here could be a real install).

    echo "--- Pre-push: all verification and integration tests passed!"
else
    # ADOPTER REPO CONTEXT
    # Nothing runs here, and that is a decision rather than an omission. Every step above is
    # either a Crucible self-test - which is exactly what this branch exists to keep off an
    # adopter tree - or a gate item 107 decided is framework-only. The one check that did cross
    # over to adopters in 107, message encoding, crossed because a commit message is unfixable
    # once pushed and is still editable at commit-msg time. At pre-push the message is already
    # written, so the same check here could only refuse the push and demand a history rewrite:
    # the shape 107 rejected when it explained why the assertion gate cannot live in pre-commit.
    # An adopter is already covered where its content is still fixable, by the pre-commit and
    # commit-msg legs that do run for it. So this branch reports, and claims nothing. The
    # closing success line used to sit outside this if/else, which told a push that ran zero
    # checks that all verification and integration tests had passed. Item 115.
    echo "Adopter: framework self-tests skipped (framework-only)."
    echo "--- Pre-push: no checks apply to an adopter project; nothing was verified."
fi
