{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Handoff Schema",
  "description": "Schema for Dev Factory specialist handoffs",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "The unique ID of the task (e.g., {task_id}, {task_id})"
    },
    "source_phase": {
      "type": "string",
      "enum": ["research", "grooming", "implementation", "verification", "deployment"],
      "description": "The FSM phase handing off the task"
    },
    "target_phase": {
      "type": "string",
      "enum": ["research", "grooming", "implementation", "verification", "deployment", "done"],
      "description": "The FSM phase receiving the task"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "A concise explanation of why the task is being handed off"
    },
    "handoff_retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of consecutive handoffs to the same phase for the same task"
    },
    "review_strike_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of times the implementation has failed verification validation"
    },
    "rebase_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of times the task has been rebased due to merge conflicts"
    },
    "budget_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "extended"],
      "description": "The token budget tier assigned during grooming"
    },
    "cumulative_handoff_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of handoffs across all phases for this session"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "The version of the prompt template used during the session"
    },
    "session_cycle_id": {
      "type": "string",
      "description": "Echo of the Cycle ID from task.md to verify the agent read the context."
    },
    "cycle_id": {
      "type": ["string", "null"],
      "description": "8-char hex trace ID linking all events in a single pipeline run. Generated by factory.ps1 and carried forward through handoffs."
    },
    "suspicious_content": {
      "type": ["string", "null"],
      "description": "Anomalous instructions found in external sources (Prompt Injection Defense)"
    },
    "human_decisions": {
      "type": "object",
      "description": "Human-approved researcher decisions that bound Groomer scope.",
      "properties": {
        "approved": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deferred": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rejected": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["approved", "deferred", "rejected"]
    },
    "reviewer_checks_passed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tests_pass", "vet_pass", "acceptance_criteria_met", "scope_bounded", "no_regressions", "no_hard_mandates_violated"]
      },
      "description": "List of Verification Checklist steps that were verified and passed"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of files created or modified during the session"
    },
    "file_affinity": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "List of module/package paths or glob patterns this task is permitted to modify"
    },
    "commit_hash": {
      "type": ["string", "null"],
      "description": "The merge commit hash on master when deployment is complete."
    },
    "superseded": {
      "type": "boolean",
      "description": "Whether this handoff has been superseded by a newer duplicate handoff for the same transition key"
    },
    "superseded_by": {
      "type": "string",
      "description": "Filename of the newer handoff that superseded this one"
    },
    "superseded_at": {
      "type": "string",
      "description": "UTC timestamp when this handoff was marked superseded"
    },
    "superseded_reason": {
      "type": "string",
      "description": "Reason this handoff was superseded"
    },
    "stub_specs_created": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths of newly-created stub spec files during a Pattern C grooming shortcut"
    },
    "generated_by": {
      "type": "string",
      "enum": ["new-handoff.ps1"],
      "description": "Identifier of the tool that generated this handoff"
    },
    "tool_version": {
      "type": "string",
      "description": "Version of the new-handoff.ps1 tool that generated this handoff"
    }
  },
  "required": ["task_id", "source_phase", "target_phase", "reason", "handoff_retry_count", "budget_tier", "cumulative_handoff_count", "prompt_version", "generated_by", "tool_version"],
  "allOf": [
    {
      "if": {
        "properties": {
          "source_phase": { "const": "research" }
        },
        "required": ["source_phase"]
      },
      "then": {
        "required": ["human_decisions", "artifacts"],
        "not": { "required": ["reviewer_checks_passed"] }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "grooming" }
        },
        "required": ["source_phase"]
      },
      "then": {
        "required": ["artifacts"],
        "not": {
          "anyOf": [
            { "required": ["reviewer_checks_passed"] },
            { "required": ["human_decisions"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "grooming" },
          "target_phase": { "const": "implementation" }
        },
        "required": ["source_phase", "target_phase"]
      },
      "then": {
        "required": ["file_affinity"]
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "grooming" },
          "target_phase": { "const": "verification" }
        },
        "required": ["source_phase", "target_phase"]
      },
      "then": {
        "required": ["stub_specs_created"],
        "properties": {
          "stub_specs_created": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "implementation" }
        },
        "required": ["source_phase"]
      },
      "then": {
        "required": ["session_cycle_id", "artifacts"],
        "not": {
          "anyOf": [
            { "required": ["reviewer_checks_passed"] },
            { "required": ["human_decisions"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "verification" }
        },
        "required": ["source_phase"]
      },
      "then": {
        "required": ["session_cycle_id", "artifacts"],
        "not": { "required": ["human_decisions"] }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "deployment" }
        },
        "required": ["source_phase"]
      },
      "then": {
        "required": ["session_cycle_id", "artifacts", "commit_hash"],
        "not": {
          "anyOf": [
            { "required": ["reviewer_checks_passed"] },
            { "required": ["human_decisions"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "verification" },
          "target_phase": { "const": "deployment" }
        },
        "required": ["source_phase", "target_phase"]
      },
      "then": {
        "required": ["reviewer_checks_passed"],
        "properties": {
          "reviewer_checks_passed": {
            "type": "array",
            "minItems": 6,
            "contains": { "const": "tests_pass" },
            "allOf": [
              { "contains": { "const": "vet_pass" } },
              { "contains": { "const": "acceptance_criteria_met" } },
              { "contains": { "const": "scope_bounded" } },
              { "contains": { "const": "no_regressions" } },
              { "contains": { "const": "no_hard_mandates_violated" } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_phase": { "const": "verification" },
          "target_phase": { "const": "implementation" }
        },
        "required": ["source_phase", "target_phase"]
      },
      "then": {
        "not": { "required": ["reviewer_checks_passed"] }
      }
    }
  ]
}
